# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# MinIO / Object Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=streamtube
MINIO_ACCESS_KEY=streamtube
MINIO_SECRET_KEY=streamtube
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_UPLOAD_PART_SIZE=5242880
MINIO_PRESIGNED_EXPIRES_IN_SECONDS=3600
MAX_VIDEO_SIZE_BYTES=10737418240

# Video processing
VIDEO_QUEUE_NAME=video-processing
VIDEO_WORKER_CONCURRENCY=2
VIDEO_PROCESSING_TIMEOUT_SECONDS=600
