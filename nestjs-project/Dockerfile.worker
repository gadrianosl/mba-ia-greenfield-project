# syntax=docker/dockerfile:1
FROM node:25.6.0-slim
COPY docker/install-system-deps.sh /usr/local/bin/install-system-deps
RUN --mount=type=secret,id=proxy_ca sh /usr/local/bin/install-system-deps ffmpeg
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
WORKDIR /usr/src/app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build
USER node
CMD ["node", "dist/worker.js"]
